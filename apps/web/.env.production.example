# Copy to apps/web/.env.production (not committed) and fill with the production Firebase web app.
# Firebase console → Project settings → Your apps → Web app → SDK config.
VITE_FIREBASE_API_KEY=REPLACE_WITH_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_APP_ID
# Worker URL (wrangler deploy prints it) + /v1
VITE_API_URL=https://gastos-viaje-api.REPLACE_WITH_SUBDOMAIN.workers.dev/v1
# Origin of the receipts bucket S3 endpoint (CSP for signed URLs)
VITE_RECEIPTS_ORIGIN=https://s3.REPLACE_WITH_REGION.backblazeb2.com
VITE_USE_EMULATORS=false
