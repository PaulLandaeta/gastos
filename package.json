{
  "name": "gastos-viaje",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --filter finance-engine --filter contracts --filter api test",
    "test:rules": "vitest run --config firebase/vitest.config.ts",
    "emulators": "JAVA_HOME=${JAVA21_HOME:-/opt/homebrew/opt/openjdk@21} PATH=${JAVA21_HOME:-/opt/homebrew/opt/openjdk@21}/bin:$PATH firebase emulators:start --project demo-gastos --only auth,firestore",
    "emulators:exec": "JAVA_HOME=${JAVA21_HOME:-/opt/homebrew/opt/openjdk@21} PATH=${JAVA21_HOME:-/opt/homebrew/opt/openjdk@21}/bin:$PATH firebase emulators:exec --project demo-gastos --only auth,firestore",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.0.0",
    "firebase": "^13.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "protobufjs",
      "@firebase/util"
    ]
  }
}
