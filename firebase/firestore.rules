rules_version = '2';

// Deny-by-default (Constitution II). Clients only READ; every write goes through the API.
// Access matrix: specs/001-finance-engine-trips/contracts/access-rules.md
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Accepted members have a members/{uid} row; invitees only have members/inv_* rows.
    function isMember(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    // Live role check: a demoted admin loses access immediately (spec 002 edge case).
    function isManager(tripId) {
      return isMember(tripId)
        && get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role
          in ['creator', 'admin'];
    }

    function ownsVerifiedEmail(email) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }

    match /trips/{tripId} {
      allow read: if isMember(tripId);
      allow write: if false;

      match /members/{memberKey} {
        allow read: if isMember(tripId);
        allow write: if false;
      }

      // RF-38: detail only for payers, beneficiaries and author (viewerUids) or managers.
      // Members' list queries must use `where('viewerUids', 'array-contains', uid)`.
      // Same rule as apps/api/src/services/visibility.ts (parity test).
      match /expenses/{expenseId} {
        allow read: if isMember(tripId)
          && (request.auth.uid in resource.data.viewerUids || isManager(tripId));
        allow write: if false;

        // Refunds (003) inherit the parent expense visibility.
        match /refunds/{refundId} {
          allow read: if isMember(tripId)
            && (request.auth.uid
                  in get(/databases/$(database)/documents/trips/$(tripId)/expenses/$(expenseId)).data.viewerUids
                || isManager(tripId));
          allow write: if false;
        }
      }

      // Payments are part of the public debt graph (RF-39).
      match /settlements/{settlementId} {
        allow read: if isMember(tripId);
        allow write: if false;
      }

      match /categories/{categoryId} {
        allow read: if isMember(tripId);
        allow write: if false;
      }

      // projections, memberStats, auditEvents and any other subcollection: API only.
      match /{subcollection}/{document=**} {
        allow read, write: if false;
      }
    }

    match /invitations/{email}/trips/{tripId} {
      allow read: if ownsVerifiedEmail(email);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      match /trips/{tripId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
